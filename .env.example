# 로컬 개발용 DB 접속 정보 — 복사해서 .env 로 사용 (.env 는 git 추적 제외)
# IntelliJ/터미널 환경변수 또는 docker-compose 에 주입
DB_HOST=localhost
DB_PORT=3308
DB_NAME=smart_travel
DB_USER=root
DB_PASSWORD=root

# ── 소셜 로그인 (선택) ──
# 아래 값을 채우고  SPRING_PROFILES_ACTIVE=oauth  로 실행하면 Google/Kakao 로그인 활성화.
# 비워두면 소셜 로그인만 비활성, 나머지는 정상 동작.
# Google: console.cloud.google.com → OAuth 클라이언트(웹)
#   승인 리디렉션 URI: http://localhost:8082/login/oauth2/code/google
GOOGLE_CLIENT_ID=603488801010-df6em03f5e46cg4sa4nnefb8jbg571vv.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
# Kakao: developers.kakao.com → 카카오 로그인
#   Redirect URI: http://localhost:8082/login/oauth2/code/kakao
#   KAKAO_CLIENT_ID = REST API 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
