# 운영(.env) 템플릿 — 서버에서  cp .env.prod.example .env  후 값을 채우세요.
# docker compose 가 자동으로 .env 를 읽습니다. (.env 는 git 에 올리지 마세요)

# 내 도메인 (DuckDNS 무료 서브도메인 등). VM 공개 IP 로 A 레코드가 연결돼 있어야 함.
APP_DOMAIN=myapp.duckdns.org

# DB
DB_NAME=smart_travel
DB_PASSWORD=강한_비밀번호로_변경

# AI (필수) — Google AI Studio 무료 키
GEMINI_API_KEY=본인_Gemini_API_키
GEMINI_MODEL=gemini-2.5-flash-lite

# 소셜 로그인 (선택) — 비우면 비활성, 이메일 로그인은 정상 동작
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
